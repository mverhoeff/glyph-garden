{
  "name": "glyph-garden",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "golden": "node scripts/make-golden.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mverhoeff/glyph-garden.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mverhoeff/glyph-garden/issues"
  },
  "homepage": "https://github.com/mverhoeff/glyph-garden#readme",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
